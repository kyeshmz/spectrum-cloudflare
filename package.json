{
  "name": "spectrum-cloudflare",
  "description": "Spectrum-style iMessage APIs with Web-only transport for Cloudflare Workers",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/kyeshmz/spectrum-cloudflare.git" },
  "homepage": "https://github.com/kyeshmz/spectrum-cloudflare#readme",
  "bugs": { "url": "https://github.com/kyeshmz/spectrum-cloudflare/issues" },
  "packageManager": "pnpm@12.14.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grpc": {
      "types": "./dist/grpc.d.ts",
      "import": "./dist/grpc.js"
    },
    "./proto/*": {
      "types": "./dist/generated/photon/imessage/v1/*_pb.d.ts",
      "import": "./dist/generated/photon/imessage/v1/*_pb.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./imessage": {
      "types": "./dist/imessage.d.ts",
      "import": "./dist/imessage.js"
    },
    "./providers/imessage": {
      "types": "./dist/providers/imessage.d.ts",
      "import": "./dist/providers/imessage.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "examples/worker/worker.ts",
    "examples/worker/build.mjs",
    "examples/worker/wrangler.jsonc",
    "examples/worker/.dev.vars.example",
    "examples/worker/README.md",
    "docs/API-CONTRACT.md",
    "docs/RUNTIME-CONTRACT.md",
    "docs/PACKAGES.md",
    "docs/UPSTREAM-COMPATIBILITY.md",
    "docs/COMPATIBILITY-PLAN.md",
    "docs/UPSTREAM-PORTING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "pnpm -r run build && node scripts/build-package.mjs .",
    "check-types": "pnpm -r run check-types && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:upstream": "vitest run tests/upstream",
    "test:compat": "vitest run tests/upstream tests/compat-*.test.ts",
    "port:setup": "node scripts/setup-oc-port.mjs",
    "oc-port": "node .oc-port/tool/dist/src/cli.js",
    "port:check": "pnpm oc-port check --collection ports.json",
    "port:sync": "pnpm oc-port sync --collection ports.json",
    "build:example": "node examples/worker/build.mjs",
    "check:generated": "node scripts/generate-api.mjs --check",
    "generate:grpc": "node scripts/generate-grpc.mjs",
    "check:grpc-generated": "node scripts/generate-grpc.mjs --check",
    "check": "pnpm check:generated && pnpm check:grpc-generated && pnpm build && pnpm check-types && pnpm test && pnpm build:example",
    "prepack": "pnpm build",
    "pack:all": "pnpm check && node scripts/pack-all.mjs",
    "check:packed": "node scripts/check-packed.mjs"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@bufbuild/buf": "1.69.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@spectrum-cloudflare/api": "workspace:*",
    "@spectrum-cloudflare/webhooks": "workspace:*",
    "@spectrum-cloudflare/imessage": "workspace:*"
  }
}
